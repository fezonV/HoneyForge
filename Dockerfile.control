FROM golang:1.27.2-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/honeyforge-control ./cmd/control

FROM alpine:3.22
RUN addgroup -S honeyforge && adduser -S -G honeyforge honeyforge
COPY --from=build /out/honeyforge-control /usr/local/bin/honeyforge-control
USER honeyforge
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/honeyforge-control"]
