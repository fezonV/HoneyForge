FROM golang:1.27.2-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then SSL_CERT_FILE=/run/secrets/proxy_ca go mod download; else go mod download; fi
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/honeyforge-agent ./cmd/agent

FROM alpine:3.22
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN addgroup -S honeyforge && adduser -S -G honeyforge honeyforge \
    && mkdir -p /var/lib/honeyforge \
    && chown honeyforge:honeyforge /var/lib/honeyforge
COPY --from=build /out/honeyforge-agent /usr/local/bin/honeyforge-agent
USER honeyforge
ENV HF_AGENT_STATE=/var/lib/honeyforge/agent-state.json \
    HF_AGENT_QUEUE=/var/lib/honeyforge/agent-events.sqlite
VOLUME ["/var/lib/honeyforge"]
ENTRYPOINT ["/usr/local/bin/honeyforge-agent"]
