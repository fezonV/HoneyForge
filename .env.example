# Copy to .env for local Compose use. Replace this placeholder with a random,
# URI-safe password before starting the stack.
POSTGRES_PASSWORD=CHANGE_ME_WITH_RANDOM_URI_SAFE_VALUE
POSTGRES_DB=honeyforge
POSTGRES_USER=honeyforge
POSTGRES_PORT=5432
CONTROL_PORT=8081

# Optional local MaxMind-compatible databases. Do not commit database files.
# Mount files under ./geoip and set paths inside the control container.
GEOIP_DATA_DIR=./geoip
GEOIP_CITY_DB=
GEOIP_ASN_DB=
GEOIP_SOURCE=
GEOIP_VERSION=

# For running `go run ./cmd/control` outside Compose, point this at PostgreSQL.
DATABASE_URL=postgres://honeyforge:CHANGE_ME_WITH_RANDOM_URI_SAFE_VALUE@127.0.0.1:5432/honeyforge?sslmode=disable
LISTEN_ADDR=127.0.0.1:8081
PUBLIC_ORIGIN=http://127.0.0.1:8081
# Local HTTP only. Production HTTPS deployments must use true.
COOKIE_SECURE=false

# Provision with `go run ./cmd/control -create-user`; values may be supplied
# through environment variables. No default account is created.
HF_USERNAME=
HF_ROLE=operator
HF_PASSWORD=
