POSTGRES_DB=honeyforge
POSTGRES_USER=honeyforge

# Hostname covered by the TLS certificate.
PUBLIC_HOST=honeyforge.example.org
# Optional distinct DNS name covered by the certificate, reachable by agents.
AGENT_HOST=
# Full Git commit SHA used to build the control image; required for remote bundles.
HF_SOURCE_REVISION=unknown
MANAGEMENT_BIND_ADDRESS=127.0.0.1
MANAGEMENT_PORT=8443
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_PORT=9443

# These files are local secrets and must not be committed.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
CONTROL_DATABASE_URL_FILE=./secrets/control_database_url
TLS_CERT_FILE=./secrets/tls.crt
TLS_KEY_FILE=./secrets/tls.key

# Optional mounted local MaxMind-compatible datasets.
GEOIP_DATA_DIR=../geoip
GEOIP_CITY_DB=
GEOIP_ASN_DB=
GEOIP_SOURCE=
GEOIP_VERSION=
